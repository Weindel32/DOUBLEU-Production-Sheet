generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  email     String?
  telefono  String?
  indirizzo String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schede    Scheda[]
}

model Logo {
  id        String       @id @default(cuid())
  nome      String
  file      String
  tipo      String
  createdAt DateTime     @default(now())
  loghi     LogoScheda[]
}

model Materiale {
  id           String            @id @default(cuid())
  nome         String
  tipo         String
  composizione String?
  peso         String?
  unitaPeso    String?
  larghezza    String?
  unitaMisura  String?
  fornitore    String?
  costoMetro   Float? // sempre €/metro lineare (convenzione condivisa con il Kit Builder)
  prezzoKg     Float? // €/kg, solo per unitaMisura = "kg"
  codice       String?
  note         String?
  foto         String? // URL della foto del cartellino o del campione
  colori       String? // JSON: codici colore del fornitore disponibili, es. ["99","100","02"]
  coloriNomi   String? // JSON: nomi validi solo per questo tessuto, es. {"180":{"nome":"Lampone","hex":"#C2185B"}}
  cartellaFoto String? // URL della foto della cartella colori
  cartellaData String? // data riportata sulla cartella, es. "06/26"
  createdAt    DateTime          @default(now())
  schede       MaterialeScheda[]
}

model Scheda {
  id            String   @id @default(cuid())
  codice        String   @unique
  nomeArticolo  String
  stato         String   @default("bozza")
  tipo          String   @default("produzione") // "produzione" | "costo" ("preventivo" = nome storico di "costo")
  // Ordine creato da un articolo di costo: id dell'articolo di partenza
  origineId     String?
  // Codice del cartamodello del modellista (es. "DUSP 09"): si ripete su più schede
  codiceModello String?
  // JSON: [{id, nome, data, voci: [{descrizione, importo}], note}] — costi di sviluppo, fuori dal costo per capo
  campioni      String?
  versione      String   @default("1.0")
  collezione    String?
  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id])

  // Tab 1 - Articolo
  categoria   String?
  vestibilita String?
  genere      String?
  stagione    String?
  utilizzo    String?
  immagini    String?

  // Specifiche prodotto
  tessutoPrincipale     String?
  pesoTessuto           String?
  altezzaTessuto        String?
  tessutoSecondario     String?
  pesoTessutoSecondario String?
  coloreBase            String?
  coloreBaseCodice      String? // codice colore del fornitore del tessuto principale, es. "100"
  coloriSecondari       String?
  coloriSecondariCodice String? // codice colore del fornitore del tessuto secondario
  collo                 String?
  maniche               String?
  noteSpecifiche        String?

  // Fornitori
  modellista       String?
  fornitoreTessuto String?
  produttore       String?

  // Tab 2 - Personalizzazione
  notePersonalizzazione String?
  colorePrincipale      String?
  coloreSecondario      String?

  // Tab 3 - Misure e quantità (JSON)
  tabellaMisure  String?
  quantitaTaglia String?

  // Tab 4 - Produzione
  noteProduzione     String?
  tolleranzaTaglio   String?
  tolleranzaCucitura String?
  tolleranzaColore   String?
  tolleranzaStampa   String?
  controlloQualita   String?
  packaging          String?
  allegati           String?

  // Costi interni
  consumoMateriale String?
  accessori        String? // JSON: [{nome, quantita, prezzoUnitario}] — costo per capo
  costoLavorazione Float?
  costoTaglio      Float?
  costoCucitura    Float?
  costoStampa      Float?
  costoRicamo      Float?
  prezzoVendita    Float?

  noteRapide String?
  createdBy  String   @default("Admin")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  loghi     LogoScheda[]
  materiali MaterialeScheda[]
}

model LogoScheda {
  id         String  @id @default(cuid())
  schedaId   String
  logoId     String
  posizione  String
  tecnica    String
  dimensione String?
  note       String?
  scheda     Scheda  @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  logo       Logo    @relation(fields: [logoId], references: [id])
}

model MaterialeScheda {
  id             String    @id @default(cuid())
  schedaId       String
  materialeId    String
  consumoPerCapo Float?
  unita          String?
  note           String?
  scheda         Scheda    @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  materiale      Materiale @relation(fields: [materialeId], references: [id])
}

// Archivio dei cartamodelli del modellista. Il codice è quello del modellista: non si rinumera.
model Modello {
  id          String   @id @default(cuid())
  codice      String   @unique
  descrizione String
  categoria   String
  fascia      String // Adulto | Uomo | Donna | Kids
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Nome DOUBLEU dei codici colore di un fornitore: lo stesso codice vale per tutti i suoi tessuti
// (per CTA il 99 è nero e il 100 blu scuro, qualunque sia l'articolo).
model ColoreFornitore {
  id        String   @id @default(cuid())
  fornitore String
  codice    String
  nome      String
  hex       String?
  doubleu   String? // colore DOUBLEU (lista chiusa in lib/colori.ts): nome per clienti e filtri
  createdAt DateTime @default(now())

  @@unique([fornitore, codice])
}
